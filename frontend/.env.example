# EduSync ERP - Frontend Environment Variables

# Backend API URL
VITE_API_URL=http://localhost:8080

# API Request Timeout (milliseconds)
# Increase this if you get "signal timed out" errors
# Default: 10000 (10 seconds)
# For slow networks or backend: 30000 (30 seconds)
VITE_API_TIMEOUT=10000

# Default Admin Password (change after first login)
VITE_ADMIN_DEFAULT_PASSWORD=ChangeMe@First1

# Production Settings (uncomment for deployment)
# VITE_API_URL=https://your-backend-domain.com
# VITE_API_TIMEOUT=15000
