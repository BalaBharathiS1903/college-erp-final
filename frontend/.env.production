# Production Environment Variables for Vercel

# Backend API URL - Update this with your deployed backend URL
# Options:
# 1. Deploy backend to Railway/Heroku and use that URL
# 2. Use serverless functions (see below)
# 3. Keep empty to use offline mode only
VITE_API_URL=https://bhc-erp-backend.onrender.com

# API Timeout (30 seconds for production)
VITE_API_TIMEOUT=30000

# Admin Password (CHANGE THIS IN PRODUCTION!)
VITE_ADMIN_DEFAULT_PASSWORD=ChangeMe@Admin1
